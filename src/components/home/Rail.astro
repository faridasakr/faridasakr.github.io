---
// Sticky left rail: identity, section nav, contact. On Home this replaces the
// shared site header and footer, which Layout suppresses via variant="rail".
//
// The active-section indicator specified in the handoff needs scroll tracking
// (IntersectionObserver) and this site ships zero client-side JavaScript, so
// it is deliberately omitted on this pass. The handoff allows that. Hover and
// focus states carry the affordance instead.
const nav = [
	{ label: 'Evidence', href: '#evidence' },
	{ label: 'Case studies', href: '#case-studies' },
	{ label: 'Track record', href: '#track-record' },
	{ label: 'Contact', href: '#contact' },
];
---

<div class="rail">
	<div class="identity">
		<p class="name">Farida Sakr</p>
		<p class="role">Partner Data Scientist, Meta</p>
	</div>

	<nav class="rail-nav" aria-label="Sections">
		{nav.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
	</nav>

	<div class="contact" id="contact">
		<a class="email" href="mailto:faridasakr@gmail.com">faridasakr@gmail.com</a>
		<a class="secondary" href="https://github.com/faridasakr" target="_blank" rel="noopener noreferrer"
			>github.com/faridasakr<span class="ext" aria-hidden="true">↗</span></a
		>
		<a
			class="secondary"
			href="https://www.linkedin.com/in/faridasakr/"
			target="_blank"
			rel="noopener noreferrer">linkedin.com/in/faridasakr<span class="ext" aria-hidden="true">↗</span></a
		>
		<a class="secondary" href="/resume.pdf">Resume (PDF)</a>
	</div>
</div>

<style>
	.rail {
		position: sticky;
		top: 0;
		align-self: start;
		height: 100vh;
		display: flex;
		flex-direction: column;
		gap: 32px;
		padding: 64px 28px 40px;
		border-right: 1px solid var(--rule);
	}

	.name {
		margin: 0;
		font-family: var(--serif);
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.role {
		margin: 4px 0 0;
		font-size: var(--fs-caption);
		color: var(--muted);
	}

	.rail-nav {
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.rail-nav a {
		font-family: var(--mono);
		font-size: var(--fs-kicker);
		letter-spacing: var(--track-nav);
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		border-left: 2px solid transparent;
		padding-left: 10px;
		transition: color 120ms ease, border-color 120ms ease;
	}

	.rail-nav a:hover {
		color: var(--ink);
		border-left-color: var(--rule);
	}

	.contact {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: var(--fs-caption);
	}

	.contact .email {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--border-strong);
		text-underline-offset: 0.25em;
	}

	.contact .secondary {
		color: var(--muted);
		text-decoration: none;
		transition: color 120ms ease;
	}

	.contact .secondary:hover {
		color: var(--ink);
	}

	/* Below the breakpoint the rail stops being a rail: it becomes a normal
	   header block at the top of the document, with the nav laid out
	   horizontally. */
	@media (max-width: 900px) {
		.rail {
			position: static;
			height: auto;
			gap: 20px;
			padding: 32px 24px 24px;
			border-right: 0;
			border-bottom: 1px solid var(--rule);
		}

		.rail-nav {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 8px 18px;
		}

		.contact {
			margin-top: 0;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 6px 18px;
		}
	}
</style>
