---
// Figure 01 — dot-and-interval, estimator comparison.
//
// Hand-placed marks on a 300x225 grid: x is linear with $0 at x=56 and $20 at
// x=220.3 (8.21px per dollar), rows at y=62/100/138. Value labels sit to the
// right of each interval so they never collide with the truth rule.
//
// Values come from ecommerce-promo-causal results/estimates.csv with the truth
// from data/ground_truth/answer_key.json. Do not round or adjust them; if that
// pipeline is re-run, this figure needs regenerating.
---

<figure class="fig">
	<div class="frame">
		<svg
			viewBox="0 0 300 225"
			preserveAspectRatio="xMidYMid meet"
			role="img"
			aria-label="Estimated promotion effect per customer against a planted truth of 5 dollars 87: naive difference in means 23 dollars 03, stabilised IPW 6 dollars 38, cross-fitted AIPW 6 dollars 42."
		>
			<text x="12" y="19" font-family="var(--mono)" font-size="9.5" letter-spacing="0.9" fill="var(--muted)">EFFECT PER CUSTOMER</text>

			<line x1="104.2" y1="47" x2="104.2" y2="180" stroke="var(--terracotta)" stroke-width="1.2" stroke-dasharray="3 3"></line>
			<text x="104.2" y="43" text-anchor="middle" font-family="var(--mono)" font-size="9.5" letter-spacing="0.6" fill="var(--terracotta)">TRUTH $5.87</text>

			<text x="12" y="66" font-family="var(--mono)" font-size="9.5" letter-spacing="0.6" fill="var(--muted)">NAIVE</text>
			<line x1="239.9" y1="62" x2="249.5" y2="62" stroke="var(--muted)" stroke-width="1.2"></line>
			<circle cx="245.1" cy="62" r="3.6" fill="var(--muted)"></circle>
			<text x="256" y="66" font-family="var(--serif)" font-size="11" font-weight="600" fill="var(--ink)">$23.03</text>

			<text x="12" y="104" font-family="var(--mono)" font-size="9.5" letter-spacing="0.6" fill="var(--muted)">IPW</text>
			<line x1="102.6" y1="100" x2="115.7" y2="100" stroke="var(--terracotta)" stroke-width="1.2"></line>
			<circle cx="108.3" cy="100" r="3.6" fill="var(--terracotta)"></circle>
			<text x="123" y="104" font-family="var(--serif)" font-size="11" font-weight="600" fill="var(--ink)">$6.38</text>

			<text x="12" y="142" font-family="var(--mono)" font-size="9.5" letter-spacing="0.6" fill="var(--accent)">AIPW</text>
			<line x1="105.1" y1="138" x2="114.8" y2="138" stroke="var(--accent)" stroke-width="1.4"></line>
			<circle cx="108.7" cy="138" r="4.2" fill="var(--accent)"></circle>
			<text x="123" y="142" font-family="var(--serif)" font-size="11" font-weight="600" fill="var(--accent)">$6.42</text>

			<line x1="56" y1="180" x2="290" y2="180" stroke="var(--rule)" stroke-width="1"></line>
			<g font-family="var(--mono)" font-size="9.5" fill="var(--faint)" text-anchor="middle">
				<text x="56" y="193">$0</text>
				<text x="138.1" y="193">$10</text>
				<text x="220.3" y="193">$20</text>
			</g>

			<text x="12" y="209" font-family="var(--mono)" font-size="9.5" letter-spacing="0.4" fill="var(--faint)">95% CI · CROSS-FITTED</text>
			<text x="12" y="221" font-family="var(--mono)" font-size="9.5" letter-spacing="0.4" fill="var(--faint)">AIPW ERROR 9.3%</text>
		</svg>
	</div>

	<figcaption>Source · ecommerce-promo-causal / results/estimates.csv</figcaption>
</figure>

<style>
	.fig {
		margin: 0;
	}

	.frame {
		aspect-ratio: 4 / 3;
		border: 1px solid var(--rule);
		background: var(--panel);
	}

	svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	figcaption {
		margin: 8px 0 0;
		font-family: var(--mono);
		font-size: var(--fs-figcaption);
		line-height: 1.45;
		letter-spacing: var(--track-figcaption);
		text-transform: uppercase;
		color: var(--faint);
	}
</style>
