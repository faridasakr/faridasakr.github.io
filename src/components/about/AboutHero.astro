---
const metadata = [
	{ label: 'Role', value: 'Partner Data Scientist' },
	{ label: 'Scope', value: 'US + LATAM telecom partners' },
	{ label: 'Mode', value: 'B2B / cross-functional' },
];
---

<header class="hero">
	<p class="now">Now / 2026</p>

	<h1>Farida Sakr</h1>
	<p class="role">Partner Data Scientist @ Meta</p>

	<p class="statement">
		I use data to understand what happened, what we should do about it, and increasingly, whether
		what we did actually created value.
	</p>

	<p class="lede">
		I work in B2B partner data science, advising telecom partners across the US and LATAM. I work at
		the point where analysis becomes a decision: in practice, that means translating between
		executives and external partners on one side and product, engineering, analytics, marketing and
		Data / ML teams on the other.
	</p>

	<dl class="meta">
		{metadata.map((m) => (
			<div class="meta-row">
				<dt>{m.label}</dt>
				<dd>{m.value}</dd>
			</div>
		))}
	</dl>

	<div class="question">
		<p class="question-label">Current question</p>
		<p class="question-text">Did the intervention actually create value?</p>
	</div>
</header>

<style>
	.hero {
		display: flex;
		flex-direction: column;
	}

	.now {
		margin: 0 0 1.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h1 {
		font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
		margin: 0 0 0.5rem;
	}

	.role {
		margin: 0 0 2.25rem;
		font-family: var(--sans);
		font-size: 1.0625rem;
		font-weight: 500;
		color: var(--muted);
	}

	.statement {
		font-family: var(--serif);
		font-size: clamp(1.875rem, 1.4rem + 2vw, 3rem);
		line-height: 1.25;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-wrap: balance;
		margin: 0 0 1.5rem;
	}

	.lede {
		font-size: 1.0625rem;
		color: var(--muted);
		max-width: 42rem;
		margin: 0 0 2rem;
	}

	.meta {
		margin: 0 0 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 3rem;
	}

	.meta-row {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}

	.meta dt {
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.meta dd {
		margin: 0;
		font-size: 0.9375rem;
	}

	.question {
		padding-top: 1.75rem;
		border-top: 1px solid var(--rule);
	}

	@media print {
		/* Chrome's print pagination unreliably honors break-inside: avoid on
		   flex children; drop to block layout for print only so the rule
		   below actually takes effect. No visual change on screen. */
		.hero {
			display: block;
		}

		.question {
			break-inside: avoid;
			page-break-inside: avoid;
		}
	}

	.question-label {
		margin: 0 0 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.question-text {
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2.25rem);
		font-style: italic;
		line-height: 1.3;
		text-wrap: balance;
	}
</style>
