---
// Country silhouettes are Natural Earth 1:110m Admin-0 boundaries
// (public domain, naturalearthdata.com, via nvkelso/natural-earth-vector),
// unioned per group and lightly simplified. An equirectangular projection
// (x = lon, y = -lat) keeps this a static, dependency-free inline SVG.
// Canada and the LATAM countries are real Natural Earth country geometries;
// the United States is shown as its own country (accent) distinct from the
// LATAM group (muted fill + bracket), since only the US is claimed at
// country-level scope. LATAM is intentionally shown as a broad regional
// annotation rather than implying presence in every country it contains.
import {
	CANADA_PATH,
	USA_PATH,
	LATAM_PATH,
	LATAM_BRACKET,
	VB_X,
	VB_Y,
	VB_W,
	VB_H,
	pos,
} from '../../data/career-map';

const canadaLabelPos = pos(-870, -520);
const usLabelPos = pos(-740, -320);
const latamLabelPos = pos(-240.8, 91.6);
---

<section aria-labelledby="map-heading">
	<p class="kicker">Scope</p>
	<h2 id="map-heading">My datasets got bigger. So did the map.</h2>
	<p class="dek">
		This traces where the work reaches, not where I've lived: it started with Canadian telecom
		network problems and grew into a B2B advisory role spanning the US and a LATAM region, not
		country-by-country coverage.
	</p>

	<div class="breakout">
		<div class="breakout-inner">
			<div class="map-wrap">
				<svg
					class="silhouette"
					viewBox={`${VB_X} ${VB_Y} ${VB_W} ${VB_H}`}
					preserveAspectRatio="xMidYMid meet"
					aria-hidden="true"
				>
					<path d={CANADA_PATH} class="land land-past" />
					<path d={LATAM_PATH} class="land land-region" />
					<path d={USA_PATH} class="land land-current" />
					<path d={LATAM_BRACKET} class="bracket" />
				</svg>

				<div class="map-labels">
					<span class="map-label label-past" style={canadaLabelPos}>Canada</span>
					<span class="map-label label-current" style={usLabelPos}>United States</span>
					<span class="map-label label-region" style={latamLabelPos}>LATAM</span>
				</div>
			</div>

			<div class="legend">
				<div class="legend-item">
					<p class="legend-label"><span class="swatch swatch-past" aria-hidden="true"></span>Canada</p>
					<p class="legend-sub">Bell &middot; predictive modelling, network analytics, data products</p>
				</div>
				<div class="legend-item">
					<p class="legend-label"><span class="swatch swatch-current" aria-hidden="true"></span>United States</p>
					<p class="legend-sub">Meta, current B2B scope &middot; partner data science, executive advisory</p>
				</div>
				<div class="legend-item">
					<p class="legend-label"><span class="swatch swatch-region" aria-hidden="true"></span>LATAM (regional)</p>
					<p class="legend-sub">Meta, current B2B scope &middot; market &amp; network analytics, not claimed country-by-country</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.kicker {
		margin: 0 0 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h2 {
		margin-top: 0;
	}

	.dek {
		max-width: 38rem;
		color: var(--muted);
		margin-bottom: 1.75rem;
	}

	.breakout {
		width: 100%;
		max-width: 960px;
		margin-inline: auto;
	}

	.breakout-inner {
		width: 100%;
	}

	@media print {
		.breakout-inner {
			break-inside: avoid;
			page-break-inside: avoid;
		}
	}

	.map-wrap {
		position: relative;
		width: min(100%, 22rem);
		margin-inline: auto;
		aspect-ratio: 1262.0 / 1140.8;
	}

	.silhouette {
		display: block;
		width: 100%;
		height: 100%;
	}

	.land {
		fill: var(--rule);
	}

	.land-region {
		fill: var(--rule);
	}

	.land-current {
		fill: var(--accent);
	}

	.bracket {
		fill: none;
		stroke: var(--accent);
		stroke-width: 4;
	}

	.map-labels {
		position: absolute;
		inset: 0;
	}

	.map-label {
		position: absolute;
		transform: translate(-50%, -50%);
		font-family: var(--sans);
		font-size: 0.6875rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.label-past {
		color: var(--muted);
	}

	.label-current {
		color: var(--bg);
	}

	.label-region {
		color: var(--accent);
		transform: translate(0, -50%);
		font-family: var(--mono);
		letter-spacing: 0.06em;
	}

	.legend {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem 1.5rem;
		margin-top: 1.75rem;
		max-width: 48rem;
		margin-inline: auto;
	}

	.legend-label {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 0.35rem;
		font-family: var(--serif);
		font-weight: 600;
		font-size: 1rem;
	}

	.swatch {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		flex: none;
	}

	.swatch-past {
		background: var(--muted);
	}

	.swatch-current {
		background: var(--accent);
	}

	.swatch-region {
		background: none;
		border: 1.5px solid var(--accent);
	}

	.legend-sub {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--muted);
	}

	@media (max-width: 40rem) {
		.legend {
			grid-template-columns: 1fr;
		}
	}
</style>
