---
import { scatterProjects } from '../../data/career';
---

<section aria-labelledby="eda-heading">
	<p class="kicker">Career EDA</p>
	<h2 id="eda-heading">A tiny EDA of one career</h2>
	<p class="dek">n = one career. Interpret accordingly.</p>

	<div class="breakout">
		<div class="breakout-inner">
			<div class="viz">
				<h3>Apparently I kept moving northeast.</h3>
				<p class="microcopy">
					Qualitative placement, not measured data (not a secretly validated psychometric
					instrument).
				</p>

				<p class="sr-only">
					Projects listed below in roughly the order they moved from technical, individual work
					toward decision-proximate, cross-functional ownership.
				</p>
				<div class="scatter">
					<div class="scatter-main">
						<div class="axis-y-labels">
							<span class="axis-y-label">Cross-functional</span>
							<span class="axis-y-label">Individual task</span>
						</div>
						<div class="plot">
							{scatterProjects.map((p) => (
								<span class="dot-marker" style={`left:${p.x}%; bottom:${p.y}%`}></span>
							))}
							{scatterProjects.map((p) => {
								const anchor = p.x >= 72 ? 'anchor-right' : p.x <= 22 ? 'anchor-left' : 'anchor-center';
								return (
									<span class={`plabel ${anchor}`} style={`left:${p.x}%; bottom:${p.y}%`}>{p.label}</span>
								);
							})}
						</div>
					</div>
					<div class="axis-x-labels">
						<span class="axis-x-label">Technical implementation</span>
						<span class="axis-x-label">Decision proximity</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.kicker {
		margin: 0 0 0.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	h2 {
		margin: 0 0 0.5rem;
	}

	.dek {
		font-family: var(--mono);
		font-size: 0.8125rem;
		color: var(--muted);
		margin-bottom: 2rem;
	}

	.breakout {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding-inline: 1.375rem;
	}

	.breakout-inner {
		max-width: 900px;
		margin-inline: auto;
	}

	.viz h3 {
		font-family: var(--serif);
		font-size: 1.25rem;
		font-weight: 600;
		margin: 0 0 0.5rem;
	}

	.microcopy {
		margin: 0 0 1.5rem;
		font-size: 0.9375rem;
		font-style: italic;
		color: var(--muted);
		max-width: 34rem;
	}

	/* Scatterplot */

	.scatter {
		margin-top: 1rem;
	}

	.scatter-main {
		display: flex;
		align-items: stretch;
		gap: 0.75rem;
	}

	.axis-y-labels {
		flex: none;
		width: 1.25rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.axis-y-label {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		font-family: var(--mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		white-space: nowrap;
	}

	.plot {
		position: relative;
		flex: 1 1 auto;
		min-width: 0;
		height: min(20rem, 46vw);
		border-left: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}

	.axis-x-labels {
		display: flex;
		justify-content: space-between;
		margin-top: 0.5rem;
		margin-left: calc(1.25rem + 0.75rem);
	}

	.dot-marker {
		position: absolute;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--accent);
		transform: translate(-50%, 50%);
	}

	.plabel {
		position: absolute;
		font-size: 0.75rem;
		line-height: 1.2;
		color: var(--fg);
		width: max-content;
		max-width: min(8.5rem, 40vw);
		transform: translate(-50%, calc(50% + 1.1rem));
		text-align: center;
	}

	.plabel.anchor-left {
		text-align: left;
		transform: translate(0, calc(50% + 1.1rem));
	}

	.plabel.anchor-right {
		text-align: right;
		transform: translate(-100%, calc(50% + 1.1rem));
	}

	.axis-x-label {
		font-family: var(--mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	@media (max-width: 40rem) {
		.plabel {
			font-size: 0.6875rem;
			max-width: min(6rem, 40vw);
		}
	}
</style>
