---
import Layout from '../layouts/Layout.astro';
import Rail from '../components/home/Rail.astro';
import Hero from '../components/home/Hero.astro';
import TrackRecord from '../components/home/TrackRecord.astro';
import CaseStudies from '../components/home/CaseStudies.astro';
import Arc from '../components/home/Arc.astro';

const description =
	'Farida Sakr: data scientist working on causal inference and on measuring whether AI systems reach conclusions the data actually supports.';
---

<Layout title="Farida Sakr | Data Scientist" description={description} variant="rail">
	<div class="shell">
		<Rail />

		<div class="column">
			<Hero />
			<TrackRecord />
			<CaseStudies />
			<Arc />
		</div>
	</div>
</Layout>

<style>
	.shell {
		display: grid;
		grid-template-columns: 232px 1fr;
		min-height: 100vh;
	}

	.column {
		min-width: 0;
	}

	@media (max-width: 900px) {
		.shell {
			grid-template-columns: 1fr;
			min-height: 0;
		}
	}
</style>
