---
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import CareerMap from '../components/about/CareerMap.astro';
import DecisionFlow from '../components/about/DecisionFlow.astro';
import ImpactStory from '../components/about/ImpactStory.astro';
import CareerHistory from '../components/about/CareerHistory.astro';
import CareerEDA from '../components/about/CareerEDA.astro';
import QuestionEvolution from '../components/about/QuestionEvolution.astro';
import CurrentFocus from '../components/about/CurrentFocus.astro';

const description =
	'Farida Sakr: Partner Data Scientist at Meta working in B2B telecom decision science, and how a statistics degree turned into causal value measurement.';
---

<Layout title="About | Farida Sakr" description={description}>
	<article>
		<AboutHero />
		<CareerMap />
		<DecisionFlow />
		<ImpactStory />
		<CareerHistory />
		<CareerEDA />
		<QuestionEvolution />
		<CurrentFocus />

		<h2>What I'm looking for</h2>
		<p>
			Senior data scientist roles with real ownership: framing the question, doing the analysis or
			model, communicating it, and staying on the hook through the decision and the measurement of
			whether it worked. Most of my experience is B2B and cross-functional, and that's shaped what I
			think ownership actually means.
		</p>

		<h2>Elsewhere</h2>
		<ul class="prose">
			<li><a href="mailto:faridasakr@gmail.com">faridasakr@gmail.com</a></li>
			<li>
				<a href="https://github.com/faridasakr" target="_blank" rel="noopener noreferrer"
					>github.com/faridasakr<span class="ext" aria-hidden="true">↗</span></a
				>
			</li>
			<li>
				<a href="https://www.linkedin.com/in/faridasakr/" target="_blank" rel="noopener noreferrer"
					>linkedin.com/in/faridasakr<span class="ext" aria-hidden="true">↗</span></a
				>
			</li>
			<li><a href="/resume.pdf">Resume (PDF)</a></li>
		</ul>
	</article>

	<p class="back"><a href="/">← Back to home</a></p>
</Layout>
