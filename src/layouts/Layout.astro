---
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />

		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-sans" preload />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<a class="brand" href="/">Farida Sakr</a>
			<nav aria-label="Primary">
				<a href="/#work">Work</a>
				<a href="/about">About</a>
				<a href="https://github.com/faridasakr" target="_blank" rel="noopener noreferrer"
					>GitHub<span class="ext" aria-hidden="true">↗</span></a
				>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<ul class="footer-links">
				<li><a href="mailto:faridasakr@gmail.com">faridasakr@gmail.com</a></li>
				<li>
					<a href="https://github.com/faridasakr" target="_blank" rel="noopener noreferrer"
						>GitHub<span class="ext" aria-hidden="true">↗</span></a
					>
				</li>
				<li>
					<a href="https://www.linkedin.com/in/faridasakr/" target="_blank" rel="noopener noreferrer"
						>LinkedIn<span class="ext" aria-hidden="true">↗</span></a
					>
				</li>
			</ul>
			<p class="colophon">Built with Astro.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #faf9f7;
		--fg: #171614;
		--muted: #5f5a52;
		--rule: #e2ded7;
		--accent: #a4462a;

		--measure: 680px;
		--sans: var(--font-sans), system-ui, sans-serif;
		--serif: var(--font-serif), Georgia, serif;
		--mono: ui-monospace, 'SF Mono', 'Cascadia Code', 'Roboto Mono', Menlo, Consolas, monospace;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #141310;
			--fg: #e9e6e0;
			--muted: #a09a90;
			--rule: #2e2b26;
			--accent: #e9a07f;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		overflow-x: hidden;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--sans);
		font-size: 1.0625rem;
		line-height: 1.65;
		font-synthesis-weight: none;
		-webkit-font-smoothing: antialiased;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.site-header,
	main,
	.site-footer {
		width: 100%;
		max-width: var(--measure);
		margin-inline: auto;
		padding-inline: 1.375rem;
	}

	main {
		flex: 1 0 auto;
		padding-block: 3.5rem 5rem;
	}

	/* Links ------------------------------------------------------------- */

	a {
		color: var(--accent);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
		text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}

	a:hover {
		text-decoration-color: var(--accent);
	}

	.ext {
		font-size: 0.75em;
		margin-inline-start: 0.2em;
		vertical-align: 0.15em;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.skip-link {
		position: absolute;
		left: 1.375rem;
		top: 0.5rem;
		padding: 0.5rem 0.75rem;
		background: var(--bg);
		border: 1px solid var(--rule);
		border-radius: 3px;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	/* Header / footer ---------------------------------------------------- */

	.site-header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		align-items: baseline;
		justify-content: space-between;
		padding-block: 2rem 0;
	}

	.brand {
		font-family: var(--serif);
		font-size: 1.0625rem;
		color: var(--fg);
		text-decoration-color: transparent;
	}

	.brand:hover {
		text-decoration-color: var(--rule);
	}

	.site-header nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9375rem;
	}

	.site-footer {
		border-top: 1px solid var(--rule);
		padding-block: 1.75rem 3rem;
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.footer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
	}

	.colophon {
		margin: 0.9rem 0 0;
	}

	/* Typography --------------------------------------------------------- */

	h1,
	h2,
	h3 {
		font-family: var(--serif);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	h1 {
		font-size: clamp(2rem, 1.55rem + 1.9vw, 2.75rem);
		margin: 0 0 1.25rem;
	}

	h2 {
		font-size: 1.3125rem;
		margin: 3rem 0 0.75rem;
	}

	p {
		margin: 0 0 1.25rem;
		text-wrap: pretty;
	}

	.lede {
		font-family: var(--serif);
		font-size: 1.25rem;
		line-height: 1.45;
		margin-bottom: 1.75rem;
	}

	.links-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin: 0 0 2.25rem;
		font-size: 0.9375rem;
	}

	.back {
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.9375rem;
	}

	ul.prose {
		margin: 0 0 1.25rem;
		padding-left: 1.15rem;
	}

	ul.prose li {
		margin-bottom: 0.75rem;
	}

	ul.prose li:last-child {
		margin-bottom: 0;
	}

	/* Tables -------------------------------------------------------------- */

	.table-wrap {
		overflow-x: auto;
		margin: 0 0 1.5rem;
	}

	.table-note {
		margin: -0.75rem 0 1.75rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.table-note sup,
	table sup {
		line-height: 0;
	}

	table {
		border-collapse: collapse;
		width: 100%;
		min-width: 30rem;
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
	}

	caption {
		text-align: left;
		color: var(--muted);
		font-size: 0.875rem;
		padding-bottom: 0.5rem;
	}

	th,
	td {
		text-align: left;
		padding: 0.55rem 0.85rem 0.55rem 0;
		border-bottom: 1px solid var(--rule);
		vertical-align: top;
	}

	thead th {
		font-weight: 500;
		color: var(--muted);
		border-bottom-color: var(--fg);
	}

	.num {
		text-align: right;
		padding-right: 0;
		padding-left: 0.85rem;
	}
</style>
