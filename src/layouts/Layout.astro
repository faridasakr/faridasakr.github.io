---
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	ogType?: 'website' | 'article';
	/**
	 * 'default' is the centred 680px measure used by About and the case
	 * studies. 'rail' is the Home page's full-bleed two-column grid, which
	 * carries its own nav and contact block in the left rail and therefore
	 * suppresses the shared header and footer.
	 */
	variant?: 'default' | 'rail';
}

const { title, description, ogType = 'website', variant = 'default' } = Astro.props;
const chrome = variant === 'default';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />

		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-sans" preload />
	</head>
	<body class={variant === 'rail' ? 'layout-rail' : undefined}>
		<a class="skip-link" href="#main">Skip to content</a>

		{chrome && (
		<header class="site-header">
			<a class="brand" href="/">Farida Sakr</a>
			<nav aria-label="Primary">
				<a href="/#work">Work</a>
				<a href="/about">About</a>
				<a href="https://github.com/faridasakr" target="_blank" rel="noopener noreferrer"
					>GitHub<span class="ext" aria-hidden="true">↗</span></a
				>
			</nav>
		</header>
		)}

		<main id="main">
			<slot />
		</main>

		{chrome && (
		<footer class="site-footer">
			<ul class="footer-links">
				<li><a href="mailto:faridasakr@gmail.com">faridasakr@gmail.com</a></li>
				<li>
					<a href="https://github.com/faridasakr" target="_blank" rel="noopener noreferrer"
						>GitHub<span class="ext" aria-hidden="true">↗</span></a
					>
				</li>
				<li>
					<a href="https://www.linkedin.com/in/faridasakr/" target="_blank" rel="noopener noreferrer"
						>LinkedIn<span class="ext" aria-hidden="true">↗</span></a
					>
				</li>
			</ul>
			<p class="colophon">Built with Astro.</p>
		</footer>
		)}
	</body>
</html>

<style is:global>
	:root {
		/* Design tokens — portfolio redesign 1c. Colour roles are taken
		   verbatim from the handoff's token table so that Home, About and the
		   case studies all speak the same visual language. */
		--page: #f3f0e9;
		--panel: #faf9f5;
		--ink: #16150f;
		--body: #4a453c;
		--muted: #6a6358;
		--faint: #8d867a;
		--rule: #ddd7c9;
		--rule-light: #e4dfd3;
		--gridline: #efebe1;
		--border-strong: #cdc5b3;
		--accent: #9a3a1c;
		--terracotta: #b4795a;
		--sand: #cfae7d;
		--trajectory: #cbbfa8;

		/* Aliases kept so existing components keep resolving. */
		--bg: var(--page);
		--fg: var(--ink);

		--measure: 680px;
		--sans: var(--font-sans), system-ui, sans-serif;
		--serif: var(--font-serif), Georgia, serif;
		--mono: ui-monospace, 'SF Mono', 'Cascadia Code', 'Roboto Mono', Menlo, Consolas, monospace;

		/* Type scale */
		--fs-display: 58px;
		--fs-stat: 34px;
		--fs-h2: 30px;
		--fs-lead: 18px;
		--fs-body: 16px;
		--fs-link: 14px;
		--fs-caption: 13px;
		--fs-kicker: 11px;
		--fs-figcaption: 10px;

		/* Mono tracking, by role */
		--track-kicker: 0.14em;
		--track-nav: 0.1em;
		--track-label: 0.08em;
		--track-figcaption: 0.06em;

		/* No rounded corners anywhere in this design. */
		--radius: 0;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			/* The handoff does not specify a dark palette; this is a
			   conservative inversion that keeps the same hue families and
			   role relationships rather than a second designed theme. */
			--page: #14130f;
			--panel: #1a1813;
			--ink: #ece8e0;
			--body: #cdc7bb;
			--muted: #a09a8d;
			--faint: #837c70;
			--rule: #302d26;
			--rule-light: #37342c;
			--gridline: #26221b;
			--border-strong: #4a4539;
			--accent: #e08a5f;
			--terracotta: #c99672;
			--sand: #d9bd91;
			--trajectory: #6b6250;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
		overflow-x: hidden;
	}

	body {
		margin: 0;
		background: var(--page);
		color: var(--body);
		font-family: var(--sans);
		font-size: var(--fs-body);
		line-height: 1.65;
		font-synthesis-weight: none;
		-webkit-font-smoothing: antialiased;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.site-header,
	main,
	.site-footer {
		width: 100%;
		max-width: var(--measure);
		margin-inline: auto;
		padding-inline: 1.375rem;
	}

	main {
		flex: 1 0 auto;
		padding-block: 3.5rem 5rem;
	}

	/* Home's rail layout is full-bleed and supplies its own padding. */
	.layout-rail main {
		max-width: none;
		padding: 0;
	}

	/* Links ------------------------------------------------------------- */

	/* Plain links are ink + underline, never rust. Rust is reserved for
	   emphasis and primary actions; the handoff calls this separation out
	   explicitly as a review fix, so keep it. */
	a {
		color: var(--ink);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
		text-decoration-color: var(--border-strong);
	}

	a:hover {
		text-decoration-color: var(--ink);
	}

	.ext {
		font-size: 0.8em;
		margin-inline-start: 0.25em;
		vertical-align: 0.15em;
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: var(--radius);
	}

	.skip-link {
		position: absolute;
		left: 1.375rem;
		top: 0.5rem;
		padding: 0.5rem 0.75rem;
		background: var(--bg);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	/* Header / footer ---------------------------------------------------- */

	.site-header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		align-items: baseline;
		justify-content: space-between;
		padding-block: 2rem 0;
	}

	.brand {
		font-family: var(--serif);
		font-size: 1.0625rem;
		color: var(--fg);
		text-decoration-color: transparent;
	}

	.brand:hover {
		text-decoration-color: var(--rule);
	}

	.site-header nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9375rem;
	}

	.site-footer {
		border-top: 1px solid var(--rule);
		padding-block: 1.75rem 3rem;
		font-size: 0.9375rem;
		color: var(--muted);
	}

	.footer-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
	}

	.colophon {
		margin: 0.9rem 0 0;
	}

	/* Typography --------------------------------------------------------- */

	h1,
	h2,
	h3 {
		font-family: var(--serif);
		color: var(--ink);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	h1 {
		font-size: clamp(2rem, 1.55rem + 1.9vw, 2.75rem);
		margin: 0 0 1.25rem;
	}

	h2 {
		font-size: 1.3125rem;
		margin: 3rem 0 0.75rem;
	}

	p {
		margin: 0 0 1.25rem;
		text-wrap: pretty;
	}

	.lede {
		font-family: var(--serif);
		font-size: 1.25rem;
		line-height: 1.45;
		margin-bottom: 1.75rem;
	}

	.links-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin: 0 0 2.25rem;
		font-size: 0.9375rem;
	}

	.back {
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-size: 0.9375rem;
	}

	ul.prose {
		margin: 0 0 1.25rem;
		padding-left: 1.15rem;
	}

	ul.prose li {
		margin-bottom: 0.75rem;
	}

	ul.prose li:last-child {
		margin-bottom: 0;
	}

	/* Tables -------------------------------------------------------------- */

	.table-wrap {
		overflow-x: auto;
		margin: 0 0 1.5rem;
	}

	.table-note {
		margin: -0.75rem 0 1.75rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--muted);
	}

	.table-note sup,
	table sup {
		line-height: 0;
	}

	table {
		border-collapse: collapse;
		width: 100%;
		min-width: 30rem;
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
	}

	caption {
		text-align: left;
		color: var(--muted);
		font-size: 0.875rem;
		padding-bottom: 0.5rem;
	}

	th,
	td {
		text-align: left;
		padding: 0.55rem 0.85rem 0.55rem 0;
		border-bottom: 1px solid var(--rule);
		vertical-align: top;
	}

	thead th {
		font-weight: 500;
		color: var(--muted);
		border-bottom-color: var(--fg);
	}

	.num {
		text-align: right;
		padding-right: 0;
		padding-left: 0.85rem;
	}

	/* Print --------------------------------------------------------------- */

	@media print {
		h1,
		h2,
		h3 {
			break-after: avoid;
			page-break-after: avoid;
		}

		/* Wide breakout sections (100vw + negative margin) constrain to the
		   printable page width instead of the screen viewport. */
		.breakout {
			width: 100% !important;
			margin-left: 0 !important;
			padding-inline: 0 !important;
		}

		/* The global footer repeats contact info already on the page (e.g.
		   the About page's "Elsewhere" section) and otherwise strands as its
		   own near-empty final printed page. Print only; footer is
		   unaffected on screen. */
		.site-footer {
			display: none;
		}

		/* The largest display type reads fine on screen but costs whole pages
		   in print at 1:1 scale; cap it without changing the on-screen sizes. */
		.statement,
		.question-text,
		.now .question,
		.tier-hero .value {
			font-size: 2.25rem !important;
		}

		/* Short standalone paragraphs (e.g. "What I'm looking for") shouldn't
		   split arbitrarily across a page boundary. */
		article > p {
			break-inside: avoid;
			page-break-inside: avoid;
		}

		img,
		svg,
		.plot {
			break-inside: avoid;
			page-break-inside: avoid;
		}
	}
</style>
